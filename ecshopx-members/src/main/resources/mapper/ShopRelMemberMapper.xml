<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shopex.ecshopx.members.mapper.ShopRelMemberMapper">

	<select id="selectUserIdsHavingAllShops" resultType="java.lang.Long">
		SELECT user_id FROM members_rel_shop
		WHERE company_id = #{companyId}
		AND shop_id IN
		<foreach collection="shopIds" item="sid" open="(" separator="," close=")">
			#{sid}
		</foreach>
		<if test="restrictUserIds != null and restrictUserIds.size() > 0">
			AND user_id IN
			<foreach collection="restrictUserIds" item="uid" open="(" separator="," close=")">
				#{uid}
			</foreach>
		</if>
		GROUP BY user_id
		HAVING COUNT(DISTINCT shop_id) = #{expectedShopCount}
	</select>

</mapper>
