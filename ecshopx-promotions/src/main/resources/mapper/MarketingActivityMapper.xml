<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shopex.ecshopx.promotions.mapper.MarketingActivityMapper">

	<select id="selectMarketingLabelsByMarketingIds" resultType="cn.shopex.ecshopx.promotions.dto.MarketingActivityLabelRow">
		SELECT marketing_id AS marketingId, marketing_name AS marketingName, promotion_tag AS promotionTag
		FROM promotions_marketing_activity
		WHERE marketing_id IN
		<foreach collection="ids" item="id" open="(" separator="," close=")">
			#{id}
		</foreach>
	</select>
</mapper>
