<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.shopex.ecshopx.orders.mapper.ShippingTemplateItemsRelationMapper">

	<select id="countByTemplatesIdAndCompanyId" resultType="long">
		SELECT COUNT(1) FROM items
		WHERE templates_id = #{templatesId} AND company_id = #{companyId}
	</select>

</mapper>
