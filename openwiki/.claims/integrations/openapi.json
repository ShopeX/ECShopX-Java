    {
      "id": "claim_1cfe03278bdb44f19aaf22c36dcc90d8",
      "statement": "OpenapiHandlerForwardRegistry is the authoritative routing table: 145 hard-coded register() calls in its constructor (44 v1.0 routes, 101 v2.0 routes; 80 POST, 45 GET, 9 DELETE, 8 PATCH, 3 PUT) filling a LinkedHashMap. The key is normalizeVersion(version) + \" \" + verb.toUpperCase() + \" \" + method.trim(), and the value is always /api/openapi/internal/v{n}/{method}. Version is part of the key, so the same method name can exist in both versions with different handlers (e.g. ecx.order.list and ecx.member.create are registered for both 1.0 and 2.0).",
      "evidence": [
        {
          "resource": "repo://ecshopx-openapi/src/main/java/cn/shopex/ecshopx/openapi/thirdapi/OpenapiHandlerForwardRegistry.java",
          "version": "repo-file-v1:sha256:8e377a45d305a7888a9bbabe2b542d0dfaa0c95ee37ff600dd91196af8843611"
