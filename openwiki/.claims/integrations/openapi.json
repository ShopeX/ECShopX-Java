    {
      "id": "claim_50c0a43b33c346638b94ed33544ef1e9",
      "statement": "Internal openapi paths are exempt from signature verification: OpenapiAuthInterceptor.preHandle returns true immediately for /api/openapi/internal/** URIs so the RequestDispatcher.forward from the gateway re-enters the chain without re-verifying. A direct external call to an internal path also skips signing; the actual guard is requireCompanyId → OpenapiAuthAttributes.requireCompanyId, which throws UnauthorizedException when the OPENAPI_AUTH request attribute is absent (rendered by OpenapiExceptionHandler as an E4004 fail envelope) — internal handlers fail closed on missing tenant context, not on a bad signature.",
      "evidence": [
        {
          "resource": "repo://ecshopx-common/src/main/java/cn/shopex/ecshopx/common/openapi/OpenapiAuthAttributes.java#L38-L56",
          "version": "repo-lines-v1:sha256:d0cbcb062e319e85405f0f6940840107b5d43adbff9d81044c1210d75c97e773:"
