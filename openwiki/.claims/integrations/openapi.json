    {
      "id": "claim_7d002d1cb19f4af7aa09f4e6c1bb6f8b",
      "statement": "OpenapiRequestParamCollector.collect builds the single shared parameter map: query string + form fields (PHP bracket-array folding) as the base, JSON body merged on top, then method back-filled from the URI path if absent. The JSON body is only re-readable because OpenapiContentCachingFilter (order HIGHEST_PRECEDENCE + 20) wraps public openapi requests in a ContentCachingRequestWrapper before the stream is consumed — without it a JSON POST could not be both signature-verified and handler-bound. resolveMethod prefers the method parameter over the path suffix after /api/openapi/, and normalizeVersion maps v2/2/2.0 → 2.0 with missing/blank → 1.0.",
      "evidence": [
        {
          "resource": "repo://ecshopx-openapi/src/main/java/cn/shopex/ecshopx/openapi/thirdapi/OpenapiRequestParamCollector.java",
          "version": "repo-file-v1:sha256:4e55969a9ea2f9fe092c333305563e66ab2fcbf43ae8bcce1b5c9e3884f8b63e"
        },
