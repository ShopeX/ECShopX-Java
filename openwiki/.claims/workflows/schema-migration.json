    {
      "id": "claim_1bb745e10ab546b39ef626069b9f0a1f",
      "statement": "The diff generator honors @Mp* attributes (columnType, length, precision, scale, nullable, defaultValue, comment, columnDefinition, unique) directly, but for entities using only stock @TableField/@TableId it infers the SQL type from a Java-type map (String to varchar(255), Integer to int(11), BigDecimal to decimal(20,2), unknown types to varchar(255)) and nullability/default from the Java field initializer; fields with exist = false are skipped, and @MpField's nullable attribute defaults to false so unmapped-nullability columns become NOT NULL.",
      "evidence": [
        {
          "resource": "repo://bin/make-migration#L557-L605",
          "version": "repo-lines-v1:sha256:00cf38531a8393655f2013311ca9c9ad4c82f4f9ff4abe720e409a09affcf4ce:"
