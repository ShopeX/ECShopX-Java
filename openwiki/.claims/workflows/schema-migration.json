  "claims": [
    {
      "id": "claim_b8ceba57f1bf4c6ab0f63586c6f4164a",
      "statement": "bin/make-migration <description> generates a Flyway migration named V<yyyyMMddHHmmss>__<slug>.sql under ecshopx-bootstrap/src/main/resources/db/migration by treating the currently connected MySQL database (read via information_schema) as the 'from' schema and the MyBatis-Plus domain mappings (@MpTable/@MpId/@MpField, falling back to @TableName/@TableId/@TableField) parsed from every ecshopx-*/src/main/java/**/domain/**/*.java file as the 'to' schema — deliberately mirroring the legacy PHP doctrine:migrations:diff flow, with the description slugified to lowercase [a-z0-9_] form.",
      "evidence": [
        {
          "resource": "repo://bin/make-migration#L157-L164",
          "version": "repo-lines-v1:sha256:fdacacaf7cdb7d608d4ff8fcce5595c218e04555df90c115a27cce9914cc331c:"
