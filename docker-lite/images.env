# Docker images: one CDN gzip bundle → gunzip -c FILE | docker load (no registry pull).
DOCKER_IMAGES_BUNDLE_URL=https://shopex-onex-yundian-image.yuanyuanke.cn/ecx-java-docker-image-base/ecx-java-docker-images.zip
# Tags expected after docker load (must match names inside the bundle)
RUNTIME_BASE_IMAGE=ecshopx-java:17-node20-openresty
APP_IMAGE=ecshopx-java:17-node20-openresty
MAVEN_BUILD_IMAGE=maven:3.9-eclipse-temurin-17
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
XXL_JOB_IMAGE=xuxueli/xxl-job-admin:2.5.0
NUXT_PUBLIC_API_BASE=/api/v1/h5app
NUXT_PUBLIC_DECORATION_ADMIN_ORIGINS=http://localhost:8080
