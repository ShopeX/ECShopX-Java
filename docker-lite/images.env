# Lite deploy images — always docker pull (no local/tar fallback).
# App 使用已推送的 runtime 基础镜像；entrypoint / nginx 模板从宿主机挂载。
RUNTIME_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/shopex_company/ecshopx-java:17-node20-openresty
APP_IMAGE=registry.cn-hangzhou.aliyuncs.com/shopex_company/ecshopx-java:17-node20-openresty
MYSQL_IMAGE=mysql:8.0
REDIS_IMAGE=redis:7-alpine
XXL_JOB_IMAGE=xuxueli/xxl-job-admin:2.5.0
NUXT_PUBLIC_API_BASE=/api/v1/h5app
NUXT_PUBLIC_DECORATION_ADMIN_ORIGINS=http://localhost:8080
